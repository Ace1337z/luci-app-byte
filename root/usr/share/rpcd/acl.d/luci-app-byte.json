{
	"luci-app-byte": {
		"description": "BYTE panel: AdGuard Home install/status/password, the DNS chain, the IPv6 uplink switch and system state",
		"read": {
			"ubus": {
				"byte": [
					"log",
					"dns_guard",
					"status"
				],
				"network.interface.wan": [
					"status"
				],
				"system": [
					"info",
					"board"
				]
			},
			"file": {
				"/tmp/luci-app-byte-setup.log": [
					"read"
				]
			}
		},
		"write": {
			"ubus": {
				"byte": [
					"agh_password",
					"action",
					"ipv6_mode",
					"setup",
					"uninstall",
					"dns_guard"
				]
			}
		}
	}
}