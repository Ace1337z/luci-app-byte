#!/bin/sh
# 60-second DNS health loop for AdGuardHome, run by /etc/init.d/agh-pw-guard.
#
# The watchdog itself is generated by the vendored agh-passwall2 installer (it
# has to agree with the installer's ports, YAML path and AdGuardHome binary), so
# this wrapper only keeps calling it. procd re-spawns this script, therefore a
# crash inside the watchdog cannot stop the health checks.
#
# It is deliberately cheap when AdGuardHome is not installed: the installer
# writes /usr/sbin/agh-pw-watchdog only when it runs, and until then this loop
# just idles.
WD=/usr/sbin/agh-pw-watchdog
INTERVAL="${AGH_PW_GUARD_INTERVAL:-60}"
IDLE="${AGH_PW_GUARD_IDLE:-300}"
while :; do
	if [ -x "$WD" ]; then
		"$WD" >/dev/null 2>&1
		sleep "$INTERVAL"
	else
		sleep "$IDLE"
	fi
done
