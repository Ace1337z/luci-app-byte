#!/bin/sh /etc/rc.common
# Keeps the AdGuardHome DNS watchdog on a 60-second loop.
#
# procd and not cron: the BYTE panel starts the vendored installer with
# --no-watchdog, so the two-minute cron entry is never added. That is exactly
# how 1.1.3 shipped with no watchdog at all, while AdGuardHome was free to sit
# on :53 with a stalled upstream. This service belongs to the package, so it
# exists whether or not the panel ever ran, and it idles when AdGuardHome is
# not installed.

START=99
STOP=10
USE_PROCD=1
PROG=/usr/sbin/agh-pw-guard

start_service() {
	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 0
	procd_set_param stdin 0
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "dhcp" "adguardhome"
}
